{
  "name": "surfer-ciac",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/build-pages.mjs && node --test tests/sprint.test.mjs tests/sprint-api.test.mjs tests/week.test.mjs && node scripts/check-questions.mjs",
    "check:questions": "node scripts/check-questions.mjs",
    "prepare:game": "node scripts/build-pages.mjs",
    "dev:game": "node scripts/build-pages.mjs && python -m http.server 8788 --directory dist",
    "build": "npm run check:sprint && node scripts/build-pages.mjs",
    "build:game": "npm run build",
    "deploy": "cf deploy --prebuilt",
    "check:worker": "node --check src/worker.js",
    "build:pages": "npm run build",
    "test:legacy": "node scripts/test-game.mjs && node --test tests/week.test.mjs && node scripts/check-questions.mjs",
    "check:sprint": "tsc -p ciac/sprint/tsconfig.json",
    "build:api": "cf build",
    "prepare:legacy": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.28",
    "wrangler": "4.157.0",
    "esbuild": "0.21.5",
    "typescript": "5.3.3",
    "miniflare": "5.20261104.0-beta"
  }
}
